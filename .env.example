# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Chain Escape multiplayer server ---
# PORT: the server listens on $PORT (default 3000). Hosting providers
# (e.g. Render) inject PORT automatically — do not hardcode it.
PORT=3000
# NODE_ENV: set to "production" on the host so the server serves the
# built client from dist/ instead of the Vite dev middleware.
NODE_ENV=development

# --- Chain Escape client (build-time, Vite) ---
# VITE_SERVER_URL: public URL of the deployed server, e.g.
# https://chain-escape-server.onrender.com — https becomes wss, http ws.
# Leave empty/unset to use the same host as the page (local dev default).
VITE_SERVER_URL=""
